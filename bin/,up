#!/bin/bash

set -e

self="$0"
platform=$( uname -s )
ref="/tmp/up.$$"

fatal() {
  echo "Fatal: $*" >&2
  exit 1
}

cleanup() {
  rm -f "$ref"
}

trap cleanup EXIT

touch -f "$self" "$ref" 

# Sync some stuff

,git pull

if [[ $self -nt $ref ]]; then
  echo "$self has changed, re-running"
  exec /bin/bash "$self"
fi

if [[ -x ~/.atuin/bin/atuin ]]; then
  atuin-update
  atuin daemon restart
  # atuin sync
fi


# Update packages

case $platform in
  Darwin)
    ;;
  Linux)
    distro=$( lsb_release -is )
    case $distro in
      Debian|Ubuntu|Raspbian)
        sudo apt update && sudo apt upgrade -y && sudo apt autoremove -y
        ;;
      *)
        fatal "Don't know how to update $platform/$distro"
        ;;
    esac

    # DuckDB (brew on Darwin)
    ~/bin/duckup
    ;;
  *)
    fatal "Don't know how to update $platform"
    ;;
esac

which brew >/dev/null && brew update && brew upgrade

# Some others

if which uv > /dev/null; then
  uv self update
else
  curl -LsSf https://astral.sh/uv/install.sh | sh
fi

for tool in ty ruff; do
  uv tool install "$tool"
  uv tool upgrade "$tool"
done

if which zvm > /dev/null; then
  zvm upgrade
else
  bash <( curl https://raw.githubusercontent.com/tristanisham/zvm/master/install.sh ) --no-env
  source $HOME/.bash.d/zvm
fi

ZVM_BASE="$HOME/.zvm"
ZVM_SETTINGS="$ZVM_BASE/settings.json"
ZVM_SETTINGS_BACKUP="$ZVM_BASE/settings.json.$$.$RANDOM"

if [[ -d $ZVM_BASE/master ]]; then
  # Capture the current master as a versioned directory
  ZIG_MASTER="$( $ZVM_BASE/master/zig version )"
  if [[ ! -d $ZVM_BASE/$ZIG_MASTER ]]; then
    echo "Copying master to $ZIG_MASTER"
    pushd "$ZVM_BASE/master" >/dev/null
    find . -type f | cpio -pld "../$ZIG_MASTER"
    popd >/dev/null
  fi
fi

# Preserve ZVM config
[[ -f $ZVM_SETTINGS ]] && cp "$ZVM_SETTINGS" "$ZVM_SETTINGS_BACKUP"
ZVM_CURRENT=$( zvm --color off ls | sed '1!G;h;$!d' | grep '\[x\]' | awk '{ print $1 }' )
zvm install master
if [[ $ZVM_CURRENT ]]; then
  echo "Using zig $ZVM_CURRENT"
  zvm use $ZVM_CURRENT
fi
[[ -f $ZVM_SETTINGS_BACKUP ]] && mv "$ZVM_SETTINGS_BACKUP" "$ZVM_SETTINGS"

if which rustup > /dev/null; then
  rustup update
fi

rm -rf "$HOME/.bun"

# vim:ts=2:sw=2:sts=2:et:ft=sh

